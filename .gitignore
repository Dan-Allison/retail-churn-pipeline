# ============================================================
# DATA & MODELS
# ============================================================

# Raw, interim, and output data — keep folders, drop contents
data/raw/*
data/interim/*
data/outputs/*
!data/raw/README.md
!data/interim/.gitkeep
!data/outputs/.gitkeep

# Trained model artifacts (created in Phase 3)
models/
!models/README.md

# Database files and dumps
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal
*.bak
*.dump
*.sql.gz


# ============================================================
# SECRETS & CONFIG
# ============================================================

# Environment files — .env.example is the only one committed
*.env
!.env.example


# ============================================================
# POWER BI (Phase 4)
# ============================================================

# Temp and lock files. The final .pbix is committed deliberately when locked.
*.pbix.tmp
~$*.pbix


# ============================================================
# LOGS & PIPELINE OUTPUTS
# ============================================================

# Anything the pipeline scripts emit at runtime.
*.log
logs/
*.out
*.err


# ============================================================
# OS METADATA
# ============================================================

# macOS — primary OS
.DS_Store
._*

# Windows — Parallels for SSMS and Power BI Desktop
Thumbs.db
Desktop.ini


